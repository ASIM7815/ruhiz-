# RUHIZ environment. Copy to .env.local (never commit real values).
# Every variable is SERVER-ONLY. None use the NEXT_PUBLIC_ prefix, so none reach the browser.

# ── Neon Postgres ─────────────────────────────────────────────
# Pooled connection string (Console → Connect → enable "Connection pooling").
NEON_DATABASE_URL=

# ── Neon Auth ─────────────────────────────────────────────────
# Console → Auth → Configuration → Auth URL, e.g. https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=
# JWKS endpoint (informational; the SDK derives it from the base URL).
NEON_AUTH_JWKS_URL=
# Random secret, at least 32 characters, used to sign the session cache cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
NEON_AUTH_COOKIE_SECRET=

# Public origin(s) of the app, comma separated. Used for CSRF origin checks and bucket CORS.
# Also add each production origin to Neon Console → Auth → Trusted origins.
APP_ORIGIN=http://localhost:3000

# ── Neon Object Storage (S3-compatible) ───────────────────────
# Branch storage endpoint: GET /projects/{project}/branches/{branch}/storage → s3_endpoint
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_REGION=us-east-2
# Existing buckets (not created by the app).
NEON_STORAGE_IMAGES_BUCKET=images
NEON_STORAGE_VIDEO_BUCKET=video
# Credential with storage:read + storage:write scopes:
#   neon credentials create --scope storage:read --scope storage:write
# token_id → ACCESS_KEY_ID, s3_secret_access_key → SECRET_ACCESS_KEY
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
